{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/scripts/hooks/guard_bash.py\"; if [ -f \"$f\" ]; then python3 \"$f\"; fi",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
